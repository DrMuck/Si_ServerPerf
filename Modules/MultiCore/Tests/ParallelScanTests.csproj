<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline tests of the ParallelScan kernel and serve logic (..\ScanKernel.cs, production file, unchanged) against an
       independent transliteration of vanilla 1.0.17 (ParallelScanTests.cs), threaded frame simulation. Normal .NET, no
       Unity, no game: UnityMathShim.cs supplies Vector3 / Quaternion / Mathf with Unity's managed implementations.
         dotnet run -c Release, project ParallelScanTests.csproj, program args: frames seed (MultiCoreTestsOut as in Directory.Build.props)
       Exit code 0 = all passed. Sources are wrapped in #if MULTICORE_OFFLINE_TESTS (the mod build sees empty files). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);MULTICORE_OFFLINE_TESTS</DefineConstants>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Kernel.cs" />
    <Compile Include="..\ScanKernel.cs" />
    <Compile Include="UnityMathShim.cs" />
    <Compile Include="ParallelScanTests.cs" />
  </ItemGroup>
</Project>
