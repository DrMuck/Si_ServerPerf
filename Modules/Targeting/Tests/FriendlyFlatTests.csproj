<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline test of FriendlyFire_Flat's cone pre-test (..\FriendlyFireFlatKernel.cs, production file, unchanged)
       against a transliteration of vanilla 1.0.17's float cone test (Target.cs:700-711 with Unity's managed
       Vector3.Angle / Mathf.Atan2 / Vector3 operators), plus a list-walk simulation (first hit and the sequence of
       entries reaching vanilla's tail must be identical). Normal .NET, no Unity, no game.
         dotnet run -c Release -project FriendlyFlatTests.csproj  [cases] [seed]
       Exit code 0 = all passed. The test source is wrapped in #if FRIENDLYFLAT_OFFLINE_TESTS (the mod build sees an
       empty file). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);FRIENDLYFLAT_OFFLINE_TESTS</DefineConstants>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\FriendlyFireFlatKernel.cs" />
    <Compile Include="FriendlyFlatTests.cs" />
  </ItemGroup>
</Project>
